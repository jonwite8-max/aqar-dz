NODE_ENV=production
APP_VERSION=0.2.0
DOMAIN=aqar.example.com
API_PORT=4000
POSTGRES_DB=aqar
POSTGRES_USER=aqar_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://aqar_app:REPLACE_WITH_LONG_RANDOM_SECRET@postgres:5432/aqar
REDIS_URL=redis://redis:6379
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=aqar-production
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_PRIVATE_KEY=REPLACE_OUTSIDE_GIT
JWT_PUBLIC_KEY=REPLACE_OUTSIDE_GIT
MEDIA_INACTIVITY_PRUNE_DAYS=7
ACCOUNT_INACTIVITY_DELETE_DAYS=365
LIFECYCLE_POLICY_VERSION=2026-09-v1

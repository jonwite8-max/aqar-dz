NODE_ENV=production
APP_VERSION=0.3.0
DOMAIN=aqar.example.com
WEB_ORIGIN=https://aqar.example.com
API_PORT=4000
TRUST_PROXY_HOPS=1
POSTGRES_DB=aqar
POSTGRES_USER=aqar_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://aqar_app:REPLACE_WITH_LONG_RANDOM_SECRET@postgres:5432/aqar
DATABASE_POOL_MAX=20
REDIS_URL=redis://redis:6379
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=aqar-production
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
OTP_PEPPER=REPLACE_WITH_DISTINCT_RANDOM_SECRET_32_BYTES_MIN
SECURITY_HASH_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET_32_BYTES_MIN
OTP_DEV_ECHO=false
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=auth@aqar.example.com
MEDIA_INACTIVITY_PRUNE_DAYS=7
ACCOUNT_INACTIVITY_DELETE_DAYS=365
LIFECYCLE_POLICY_VERSION=2026-09-v2
